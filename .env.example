ENV=development

CORE_WRITER_URL=postgresql+asyncpg://user:pass@localhost:5432/core
CORE_READER_URL=postgresql+asyncpg://user:pass@localhost:5432/core
RESERVATION_WRITER_URL=postgresql+asyncpg://user:pass@localhost:5433/reservation
RESERVATION_READER_URL=postgresql+asyncpg://user:pass@localhost:5433/reservation

# 로컬은 docker-compose redis. 운영(ElastiCache)은 TLS 필수 → rediss:// 스킴 사용
# 예) rediss://<cluster>.serverless.apn2.cache.amazonaws.com:6379/0
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me-in-prod
JWT_ACCESS_TTL_SECONDS=1800
JWT_REFRESH_TTL_SECONDS=1209600

AWS_REGION=ap-northeast-2
# 로컬은 LocalStack 등 가짜 endpoint 사용 가능, 운영은 비워두기
AWS_ENDPOINT_URL=http://localhost:4566
SQS_RESERVATION_QUEUE_URL=http://localhost:4566/000000000000/reservation-write

SEAT_HOLD_TTL_SECONDS=2592000

# 결제 단건 조회 캐시 TTL (cache-aside) — 결제 기록은 불변이라 TTL 만으로 충분
PAYMENT_CACHE_TTL_SECONDS=3600
