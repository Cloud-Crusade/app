ENV=development

# 프론트엔드(cc/web) 교차 출처 허용 origin (JSON 배열). 미설정 시 로컬 dev 기본값 사용
# CORS_ALLOW_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 서비스별 DB — 각 서비스 배포 env 가 자기 롤 크리덴셜로 주입(물리 DB 공유, GRANT 는 cc/infra).
# auth/event → RDS#1, reservation/payment → RDS#2 (각자 자기 테이블만 접근)
# 호스트는 고정 CNAME/RDS Proxy 권장 — 엔드포인트 컷오버 시 앱 URL 불변(deploy/README 참조)
DB_WRITER_URL=postgresql+asyncpg://user:pass@localhost:5432/core
DB_READER_URL=postgresql+asyncpg://user:pass@localhost:5432/core
# 엔드포인트 컷오버 수렴 주기 (컷오버 운영 시 짧게)
DB_POOL_RECYCLE_SECONDS=1800

# 로컬은 docker-compose redis. 운영(ElastiCache)은 TLS 필수 → rediss:// 스킴 사용
# 호스트는 ElastiCache primary 엔드포인트(페일오버 시 DNS 고정) 또는 고정 CNAME 권장
# 예) rediss://<cluster>.serverless.apn2.cache.amazonaws.com:6379/0
REDIS_URL=redis://localhost:6379/0
# 페일오버·엔드포인트 컷오버 시 idle 커넥션 재연결 주기 (DB pool_recycle 격)
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30

JWT_SECRET=change-me-in-prod
JWT_ACCESS_TTL_SECONDS=1800
JWT_REFRESH_TTL_SECONDS=1209600

AWS_REGION=ap-northeast-2
# 로컬은 LocalStack 등 가짜 endpoint 사용 가능, 운영은 비워두기
AWS_ENDPOINT_URL=http://localhost:4566
SQS_RESERVATION_QUEUE_URL=http://localhost:4566/000000000000/reservation-write

SEAT_HOLD_TTL_SECONDS=2592000

# 결제 단건 조회 캐시 TTL (cache-aside) — 결제 기록은 불변이라 TTL 만으로 충분
PAYMENT_CACHE_TTL_SECONDS=3600

# 예매 단건 조회 캐시 TTL (cache-aside) — 취소로 변경 가능하므로 짧게 + cancel 시 무효화
RESERVATION_CACHE_TTL_SECONDS=300

# 봇/매크로 억제용 ALTCHA PoW 캡차 (기본 비활성). 활성 시 web 도 VITE_CAPTCHA_ENABLED=true 필요
CAPTCHA_ENABLED=false
CAPTCHA_HMAC_SECRET=
CAPTCHA_COMPLEXITY=100000

# 서비스 간 gRPC — 서버 listen 포트 + 클라이언트 타깃
# 멀티 pod 는 dns:///<headless-service>:50051 형식으로 round_robin 분산
GRPC_PORT=50051
EVENT_GRPC_TARGET=localhost:50051
RESERVATION_GRPC_TARGET=localhost:50051
